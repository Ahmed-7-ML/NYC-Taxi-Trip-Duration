      "isDeleted": false,
      "boundElements": null,
      "updated": 1791103880544,
      "link": null,
      "locked": false,
      "text": "def predict(x: pd.DataFrame):\n    model = load_model()\n    preprocessor = load_preprocessor()\n    \n    x_preprocessed = preprocessor.process(X)\n    preds = model.predict(x_preprocessed)\n\n    return preds",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def predict(x: pd.DataFrame):\n    model = load_model()\n    preprocessor = load_preprocessor()\n    \n    x_preprocessed = preprocessor.process(X)\n    preds = model.predict(x_preprocessed)\n\n    return preds",
      "autoResize": true,
      "lineHeight": 1.25
    },
