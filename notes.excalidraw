    {
      "id": "rZzpZNGZpYaA2d1NNDDLB",
      "type": "text",
      "x": 1179.730131030495,
      "y": 1759.3552852162272,
      "width": 719.1195678710938,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
