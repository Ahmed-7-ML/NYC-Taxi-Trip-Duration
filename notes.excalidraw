      "seed": 334006980,
      "version": 514,
      "versionNonce": 77420228,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790615299042,
      "link": null,
      "locked": false,
      "text": "Difference between print() & logging:\n    - logging:\n        - Error Management\n        - Control by Levels\n        - Part of Architecture\n    \n    - Log Levels:\n        1. INFO        --> Normal Progress Messages\n        2. DEBUG    --> Detailed Information for Developers\n        3. WARNING  --> Something unexpected but not critical\n        4. ERROR     --> Serious Problem Occurred\n        5. CRITICAL --> System in Trouble\n    \n    - Automatically add:\n        - Timestamp\n        - Module/Function Name\n        - Line Number\n        - Log Level",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Difference between print() & logging:\n    - logging:\n        - Error Management\n        - Control by Levels\n        - Part of Architecture\n    \n    - Log Levels:\n        1. INFO        --> Normal Progress Messages\n        2. DEBUG    --> Detailed Information for Developers\n        3. WARNING  --> Something unexpected but not critical\n        4. ERROR     --> Serious Problem Occurred\n        5. CRITICAL --> System in Trouble\n    \n    - Automatically add:\n        - Timestamp\n        - Module/Function Name\n        - Line Number\n        - Log Level",
      "autoResize": true,
      "lineHeight": 1.25
    },
