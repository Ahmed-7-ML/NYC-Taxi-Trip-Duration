      "seed": 1389400793,
      "version": 388,
      "versionNonce": 325591767,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791105803122,
      "link": null,
      "locked": false,
      "text": "Flask vs. FastAPI vs. Django\n    \n    1.  FastAPI\n        - Python-Native (Pythonic)\n        - Integrated with Pydantic for Automatic Input/Output Validation\n        - Automatic Documentation (Open API)\n        - Async Support as FastAPI built on ASGI (Non-Blocking)\n\nGlobal Interpreter Lock (GIL) Problem in Python",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Flask vs. FastAPI vs. Django\n    \n    1.  FastAPI\n        - Python-Native (Pythonic)\n        - Integrated with Pydantic for Automatic Input/Output Validation\n        - Automatic Documentation (Open API)\n        - Async Support as FastAPI built on ASGI (Non-Blocking)\n\nGlobal Interpreter Lock (GIL) Problem in Python",
      "autoResize": true,
      "lineHeight": 1.25
    },
