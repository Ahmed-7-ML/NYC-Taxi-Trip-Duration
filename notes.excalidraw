    {
      "id": "iBEmyydVpPIYdOPnmzC1n",
      "type": "text",
      "x": 62.298182571375705,
      "y": 436.9535513597508,
      "width": 1007.3593139648438,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
